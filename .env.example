# Las cámaras públicas funcionan sin Render, mediante dos rewrites de Vercel
# a las imágenes autorizadas TfL. YOLO ONNX/WASM corre en el navegador.
# No es necesaria ninguna variable de entorno para las cámaras públicas.
# Para mantener una API opcional de salud/estado:
# VITE_VISION_MODE=real
# VITE_VISION_API_BASE_URL=https://SERVICIO_RENDER_CONFIRMADO.onrender.com
# En Render Free, si se utiliza:
# VISION_ALLOWED_ORIGINS=https://DOMINIO_VERCEL_CONFIRMADO.vercel.app
# Nunca colocar contraseñas ni tokens en VITE_: son variables públicas.
