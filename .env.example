# Frontend: YOLO ONNX/WASM funciona en el navegador y procesa
# simulaciones 3D o imágenes públicas de tráfico TfL.
# Para usar las cámaras públicas, configura el origen HTTPS de Render.
# Estas variables son públicas en el build Vite, nunca claves secretas.
VITE_VISION_MODE=real
VITE_VISION_API_BASE_URL=https://SERVICIO_RENDER_CONFIRMADO.onrender.com
#
# Backend Render Free:
# VISION_ALLOWED_ORIGINS=https://DOMINIO_VERCEL_CONFIRMADO.vercel.app
# El backend solo consulta un conjunto fijo de imágenes TfL;
# no recibe imágenes subidas, no ejecuta inferencia, no almacena video.
